console.log('number' + 3 + 3); //number33 - перобразование чисел в строку, конкатенация
console.log(null + 3); // 3 – null превращается в 0, суммируются
console.log(5 && "qwerty"); //"qwerty" – последний true в ряду сравнений, логическое «и»
console.log(+'40' + +'2' + "hillel"); //42hillel - конвертация строк в числа, сумма значений и конкатенация
console.log('10' - 5 === 6); //false - неравенство
console.log(true + false); //1 – сумма 1 и 0
console.log('4px' - 3); //NaN – разные типы данных
console.log('4' - 3); // 1 – разные типы данных, но 4 можно перевести в число, потом математическое действие
console.log('6' + 3 ** 0); //61 – математические действия по возведению в степень и конкатенация, потому что начиналось со строки
console.log(12 / '6'); //2 – 6 приводится к номеру, математические действия
console.log('10' + (5 === 6)); //10false – выражение в скобках сначала, потом конкатенация, 10 не конвертируется в число, потому что запись начинается со строки
console.log(null == ''); //false – пустое значение равно пустому значению – false по умолчанию
console.log(3 ** (9 / 3)); //27 – тройка в степени, математическая операция
console.log(!!'false' == !!'true'); //true – буллиновское сравнение, сначала строка с "false" принимает значение false, но второй воскрицательный знак делает её true, "true" тоже сначала становится false, а потом true; true = true
console.log(0 || '0' && 1); //1 – сначала "и" оператор (true + true) возвращает последнее true, потом "или" возвращает значение true 
console.log((+null == false) < 1); //false – сначала действие в скобках, где +null выводится как null, false=false
console.log(false && true || true); //сначала "и" возвращает false, потом "или" - true
console.log(false && (false || true)); //false – сначала действие в скобках, потом "и"
console.log((+null == false) < 1 ** 5); //false – действие в скобках,  +null выводится как null, false=false
