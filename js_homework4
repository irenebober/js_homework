function checkProbabilityTheory(count) {
  let pairCount = 0, oddCount = 0;

  for (let i = 0; i < count; i++) {
        let randomNumber = Math.floor(Math.random() * 901) + 100; //самая сложная часть для понимания, без гпт вообще не давалась 😭 
               
    if (randomNumber % 2 === 0) {
      pairCount++;
    } else {
      oddCount++;
    }
  }

  let pairPercent = (pairCount / count) * 100;
  let oddPercent = (oddCount / count) * 100;

  console.log("Кількість згенерованих чисел: " + count);
  console.log("Парних чисел: " + pairCount);
  console.log("Не парних чисел: " + oddCount);
  console.log("Відсоток парних: " + pairPercent + "%");
  console.log("Відсоток не парних: " + oddPercent + "%");
}

checkProbabilityTheory(1000);